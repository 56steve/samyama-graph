[0.001, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33md:D\u001b[0m\u001b[33misease\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m<-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:REPORT_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mr:DiseaseReport\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN d.name AS disease, \u001b[0m\u001b[1;33mcount\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mr\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS \u001b[0m\r\n\u001b[33mreports ORDER BY reports DESC LIMIT \u001b[0m\u001b[1;33m8\u001b[0m\r\n"]
[0.009, "o", "\u001b[1;35mdisease                                        \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35m \u001b[0m\u001b[1;35mreports\u001b[0m\r\nNumber of reported cases of yellow fever         9049   \r\nReported cases of dengue fever                   9008   \r\nTuberculosis incidence (per 100 000 population)  5177   \r\nTB deaths (excluding HIV+TB)                     4677   \r\nEstimated number of people living with HIV       3938   \r\nNumber of people dying from HIV-related causes   3760   \r\nNumber of new HIV infections                     3759   \r\nNumber of reported deaths from cholera           2374   \r\n"]
